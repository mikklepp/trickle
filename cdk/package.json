{
  "name": "trickle-cdk",
  "version": "1.1.1",
  "description": "Trickle CDK Infrastructure",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc && cdk synth",
    "watch": "tsc -w",
    "cdk": "cdk",
    "diff": "cdk diff --all",
    "synth": "cdk synth",
    "deploy": "cdk deploy --all --require-approval=never",
    "destroy": "cdk destroy --all"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "aws-cdk": "^2.1138.0",
    "dotenv": "^17.2.3",
    "esbuild": "^0.28.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@aws-sdk/client-sts": "^3.1115.0",
    "aws-cdk-lib": "^2.267.0",
    "constructs": "^10.8.1"
  }
}
