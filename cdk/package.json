{
  "name": "trickle-cdk",
  "version": "1.1.1",
  "description": "Trickle CDK Infrastructure",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc && cdk synth",
    "watch": "tsc -w",
    "cdk": "cdk",
    "diff": "cdk diff --all",
    "synth": "cdk synth",
    "deploy": "cdk deploy --all --require-approval=never",
    "destroy": "cdk destroy --all"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "aws-cdk": "^2.1132.0",
    "dotenv": "^17.2.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@aws-sdk/client-sts": "^3.1090.0",
    "aws-cdk-lib": "^2.267.0",
    "constructs": "^10.7.0"
  }
}
